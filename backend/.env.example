# =================================================================
# KnoQuest — Enterprise Knowledge Agent Environment Configuration
# =================================================================

# Server Settings
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mode Configuration:
# - Set to true when you have active Azure Foundry & Search deployments
# - Set to false to use the resilient local enterprise sandbox (ideal for offline/demo backup)
AZURE_MODE=false

# -----------------------------------------------------------------
# 1. Microsoft Foundry Project Configuration
# -----------------------------------------------------------------
# Found in: Azure AI Foundry Portal -> Overview -> Project Endpoint or Connection String
# Example: https://<your-hub-name>.<region>.api.azureml.ms
AZURE_PROJECT_ENDPOINT=
# Or Foundry Project Connection String (format: <subscription_id>;<resource_group>;<project_name>)
AZURE_PROJECT_CONNECTION_STRING=
# Model deployment name in Foundry (e.g. gpt-4o-mini, gpt-4.1-mini)
AZURE_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# -----------------------------------------------------------------
# 2. Azure OpenAI Direct Access (Alternative if using OpenAI directly)
# -----------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# -----------------------------------------------------------------
# 3. Azure AI Search Configuration
# -----------------------------------------------------------------
# Found in Azure Portal -> Azure AI Search -> Overview / Keys
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=knoquest-novatech-index

# -----------------------------------------------------------------
# 4. Azure Cognitive Services Speech
# -----------------------------------------------------------------
# Found in Azure Portal -> Azure AI Speech -> Keys & Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# -----------------------------------------------------------------
# 5. Security & Authentication
# -----------------------------------------------------------------
# Set to true to use Azure CLI / Managed Identity (DefaultAzureCredential)
USE_AZURE_CREDENTIAL=false
